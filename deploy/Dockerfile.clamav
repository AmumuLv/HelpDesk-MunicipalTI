FROM clamav/clamav:1.4 AS xml-security
USER root
ENV CFLAGS="-O2 -fstack-protector-strong -D_FORTIFY_SOURCE=3" \
    LDFLAGS="-Wl,-z,relro,-z,now"
RUN apk add --no-cache build-base curl patch xz zlib-dev xz-dev \
    && mkdir /build && cd /build \
    && curl -fsSL https://download.gnome.org/sources/libxml2/2.13/libxml2-2.13.9.tar.xz -o xml.tar.xz \
    && echo 'a2c9ae7b770da34860050c309f903221c67830c86e4a7e760692b803df95143a  xml.tar.xz' | sha256sum -c - \
    && curl -fsSL https://github.com/GNOME/libxml2/commit/d1686f91dbda141a752200419d35639fd6b38340.patch -o xml.patch \
    && echo '5e51f8dcadfe3294a15d9e8644d61e8d92bd5b9e72c10cf13ef010eccfbfa4df  xml.patch' | sha256sum -c - \
    && curl -fsSL https://gitlab.alpinelinux.org/alpine/aports/-/raw/3.24-stable/main/libxml2/CVE-2026-6732.patch -o alpine.patch \
    && echo '42d45b35f36bf29229e39a9e5349d7347e51d92099573b5a509f448dbf0e34d7  alpine.patch' | sha256sum -c - \
    && curl -fsSL https://gitlab.alpinelinux.org/alpine/aports/-/raw/3.24-stable/main/libxml2/CVE-2026-6732-test.patch -o alpine-test.patch \
    && echo '7c93e102dfdeaaf5d7adeda70c0dec6bfc492dbe9a14a29d42512a6c3f39a6c2  alpine-test.patch' | sha256sum -c - \
    && tar xf xml.tar.xz && cd libxml2-2.13.9 \
    && patch -p1 < ../alpine.patch && patch -p1 < ../alpine-test.patch && patch -p1 < ../xml.patch \
    && ./configure --prefix=/usr --without-python --without-icu --with-legacy --with-lzma --with-zlib \
    && make -j2 && make check && make DESTDIR=/patched install

FROM clamav/clamav:1.4
# Aplica actualizaciones del sistema y retira el cliente HTTP no utilizado.
# No admitir de nuevo la versión señalada por CVE-2026-4738.
RUN apk upgrade --no-cache && apk add --no-cache xz-libs 'zlib>=1.4-r0' && apk del curl \
    && apk info -v | grep -qx 'libxml2-2.13.9-r2'
COPY --from=xml-security /patched/usr/lib/libxml2.so* /usr/lib/
RUN mkdir -p /usr/local/share/helpdesk \
    && sha256sum /usr/lib/libxml2.so.2 > /usr/local/share/helpdesk/libxml2.sha256 \
    && printf '%s\n' 'CVE-2026-86140: upstream backport d1686f91dbda141a752200419d35639fd6b38340; Python bindings disabled; make check passed in builder.' > /usr/local/share/helpdesk/libxml2-backport.txt
