ARG MONGO_VERSION=8.0.34
ARG MONGO_BASE_IMAGE=mongo:${MONGO_VERSION}
# Conserva MongoDB 8.0 y recompila sus utilidades con el toolchain corregido.
FROM golang:1.26.9-alpine AS herramientas
RUN apk add --no-cache git
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOMAXPROCS=2
WORKDIR /src
RUN git clone --depth 1 --branch 100.19.1 https://github.com/mongodb/mongo-tools.git tools
WORKDIR /src/tools
RUN go mod edit -require=golang.org/x/net@v0.62.0 \
    && go mod edit -require=github.com/klauspost/compress@v1.20.2 \
    && for herramienta in bsondump mongodump mongoexport mongofiles mongoimport mongorestore mongostat mongotop; do \
         go build -mod=mod -p=2 -trimpath -ldflags="-s -w -X main.VersionStr=100.19.1 -X main.GitCommit=9348e032419d906e40966f477278cce647b9b1eb" \
           -o /out/$herramienta ./$herramienta/main; \
       done
RUN set -e; test "$(git rev-parse HEAD)" = 9348e032419d906e40966f477278cce647b9b1eb; for herramienta in bsondump mongodump mongoexport mongofiles mongoimport mongorestore mongostat mongotop; do /out/$herramienta --version >/dev/null; done
WORKDIR /src
RUN git clone --depth 1 --branch 1.19 https://github.com/tianon/gosu.git gosu \
    && cd gosu && test "$(git rev-parse HEAD)" = 6456aaa0f3c854d199d0f037f068eb97515b7513 && go build -mod=mod -p=2 -trimpath -ldflags="-s -w" -o /out/gosu .

RUN mkdir -p /out/js-yaml && wget -q https://registry.npmjs.org/js-yaml/-/js-yaml-3.15.2.tgz -O /tmp/js-yaml.tgz \
    && echo "7f005cf0b8ee639b4557e0e321dc067c1f2aa0a442d096e03f2ab53353738794  /tmp/js-yaml.tgz" | sha256sum -c - \
    && tar -xzf /tmp/js-yaml.tgz --strip-components=1 -C /out/js-yaml

FROM ${MONGO_BASE_IMAGE} AS runtime
# Actualiza el decodificador Brotli sin cambiar MongoDB ni sus datos.
RUN apt-get update \
    && apt-get install -y --no-install-recommends --only-upgrade libbrotli1 apt \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' apt)" ge '2.8.4ubuntu0.1' \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libbrotli1)" ge '1.1.0-2ubuntu0.1' \
    && rm -rf /var/lib/apt/lists/*
# mongosh also embeds Node/Brotli; patching the OS library alone is insufficient.
RUN apt-get -o Dir::Etc::sourcelist=/etc/apt/sources.list.d/mongodb-org.list \
        -o Dir::Etc::sourceparts=- update \
    && apt-get install -y --no-install-recommends --only-upgrade mongodb-mongosh=2.14.1 \
    && dpkg --compare-versions "$(mongosh --nodb --quiet --eval 'print(process.versions.node)')" ge '24.22.1' \
    && rm -rf /var/lib/apt/lists/*
COPY --from=herramientas /out/bsondump /out/mongodump /out/mongoexport /out/mongofiles /out/mongoimport /out/mongorestore /out/mongostat /out/mongotop /usr/bin/
COPY --from=herramientas /out/gosu /usr/local/bin/gosu
COPY --from=herramientas /out/js-yaml/ /opt/js-yaml/

# Copia el sistema final para distribuir solamente las utilidades actualizadas.
FROM scratch
COPY --from=runtime / /
ARG MONGO_VERSION
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    GOSU_VERSION=1.19 JSYAML_VERSION=3.15.2 MONGO_PACKAGE=mongodb-org \
    MONGO_REPO=repo.mongodb.org MONGO_MAJOR=8.0 MONGO_VERSION=${MONGO_VERSION} \
    HOME=/data/db GLIBC_TUNABLES=glibc.pthread.rseq=0
VOLUME /data/db /data/configdb
EXPOSE 27017
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["mongod"]
