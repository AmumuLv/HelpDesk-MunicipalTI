# Proxy inverso único para la API y el frontend.
#
# SITE_ADDRESS se define en .env:
#   - SITE_ADDRESS=http://localhost        -> solo HTTP local (por defecto)
#   - SITE_ADDRESS=tickets.muni.gob.pe     -> HTTPS automatico con certificado
#                                             real (Let's Encrypt) si el dominio
#                                             resuelve a esta maquina.
#
# Rutas:
#   /api/*  /ws/*   -> FastAPI (incluye WebSocket, Caddy gestiona el upgrade)
#   /healthz        -> sonda del balanceador
#   /*               -> Nginx del frontend (SPA, index.html fallback)

{$SITE_ADDRESS} {
	encode zstd gzip

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>uri query {
					delete token
					delete access_token
					delete api_key
				}
			}
		}
	}

	@api path /api /api/* /ws /ws/*
	handle @api {
		reverse_proxy {$API_UPSTREAM:api:8000} {
			flush_interval -1
		}
	}

	handle /healthz {
		respond "ok" 200
	}

	handle {
		reverse_proxy {$WEB_UPSTREAM:web:80}
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(self), camera=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws: wss:; media-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
