--- a/helpdesk_security_test.go
+++ b/helpdesk_security_test.go
@@ -0,0 +1,34 @@
+package jose
+
+import (
+ "encoding/base64"
+ "encoding/json"
+ "math/big"
+ "testing"
+)
+
+func TestHelpdeskRejectsOversizedRSA(t *testing.T) {
+ n := new(big.Int).Lsh(big.NewInt(1), 8192)
+ raw := map[string]string{"kty":"RSA", "n":base64.RawURLEncoding.EncodeToString(n.Bytes()), "e":"Aw"}
+ data, _ := json.Marshal(raw)
+ var key JSONWebKey
+ if err := key.UnmarshalJSON(data); err == nil { t.Fatal("oversized modulus accepted") }
+}
+
+func TestHelpdeskRejectsMismatchedPrivatePrimes(t *testing.T) {
+ var key JSONWebKey
+ if err := key.UnmarshalJSON([]byte(`{"kty":"RSA","n":"Nw","e":"Aw","d":"AQ","p":"BQ","q":"DQ"}`)); err == nil { t.Fatal("mismatched primes accepted") }
+}
+
+func TestHelpdeskRejectsPrivateMaterialInHeaders(t *testing.T) {
+ var header rawHeader
+ if err := json.Unmarshal([]byte(`{"jwk":{"kty":"RSA","n":"Nw","e":"Aw","d":"AQ","p":"BQ","q":"Cw"},"epk":{"kty":"oct","k":"AQ"}}`), &header); err != nil { t.Fatal(err) }
+ if _, err := header.sanitized(); err == nil { t.Fatal("private JWK accepted") }
+ if _, err := header.getJWK(); err == nil { t.Fatal("private JWK accepted by getter") }
+ if _, err := header.getEPK(); err == nil { t.Fatal("private EPK accepted") }
+}
+
+func TestHelpdeskAllowsPublicKey(t *testing.T) {
+ var key JSONWebKey
+ if err := key.unmarshalJSON([]byte(`{"kty":"RSA","n":"Nw","e":"Aw"}`), false); err != nil { t.Fatal(err) }
+}
