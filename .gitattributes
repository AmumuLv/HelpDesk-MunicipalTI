* text=auto
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.cmd text eol=crlf
Dockerfile text eol=lf
# Unified patch context includes leading spaces before source tabs and blank lines.
deploy/security/*.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.xlsx binary
*.pdf binary
