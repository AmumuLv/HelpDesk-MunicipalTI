# ─────────────────────────────────────────────────────────────
# Sistema de Mesa de Ayuda TI con IA para Municipalidad
# Copiar a .env y ajustar. NUNCA versionar el .env real.
# ─────────────────────────────────────────────────────────────

# ── Aplicación ───────────────────────────────────────────────
APP_NAME="Mesa de Ayuda TI"
APP_ENV=production                 # development | production
API_PREFIX=/api
LOG_LEVEL=INFO
# Red usada solo al compilar. Si Docker Desktop no llega a npm con default,
# habilita su red host y configura BUILD_NETWORK=host.
BUILD_NETWORK=default
# Origenes permitidos separados por coma (CORS estricto)
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:8080

# ── Zona horaria de negocio ──────────────────────────────────
# Todo se almacena en UTC; esta zona solo define la presentación
# y el cálculo de horario laboral, SLA y feriados.
BUSINESS_TIMEZONE=America/Lima

# ── Seguridad ────────────────────────────────────────────────
# OBLIGATORIO cambiar en producción. Longitud mínima 32 caracteres.
SECRET_KEY=cambia-esta-clave-por-una-de-al-menos-32-caracteres-aleatoria
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false                # true cuando se sirve por HTTPS
COOKIE_SAMESITE=lax
# Saltos de argon2id
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
# Ventana de bloqueo por intentos fallidos
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Rate limiting global (requests por minuto y clave)
RATE_LIMIT_PER_MINUTE=300
# Clave para cifrar secretos de licencia (Fernet). OBLIGATORIA en producción.
LICENSE_ENCRYPTION_KEY=

# ── MongoDB ──────────────────────────────────────────────────
MONGO_URI=mongodb://mongo:27017/?replicaSet=rs0
MONGO_DB=mesa_ayuda

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Almacenamiento de archivos ───────────────────────────────
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=15
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ── IA (capa de abstracción de proveedor) ────────────────────
# IA_GLOBAL_ENABLED | AI_PROVIDER=openai_compatible | AI_BASE_URL | AI_API_KEY | AI_MODEL
AI_GLOBAL_ENABLED=true
AI_LEARNING_ENABLED=true
AI_PROVIDER=openai_compatible
AI_BASE_URL=http://llm:11434/v1
AI_API_KEY=local
AI_MODEL=qwen2.5:7b
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=1200
# Interruptor global de la interfaz de recomendaciones (visible)
AI_RECOMMENDATIONS_ENABLED=true
# Valor por defecto de las recomendaciones para cuentas nuevas
AI_RECOMMENDATIONS_DEFAULT=true

# ── Exportaciones y respaldos ────────────────────────────────
EXPORT_DIR=/data/exports
BACKUP_DIR=/data/backups
BACKUP_RETENTION_DAYS=30
BACKUP_CRON_HOUR=2

# ── Catálogos / institutions ─────────────────────────────────
INSTITUTION_NAME=Municipalidad
INSTITUTION_SHORT_NAME=Municipalidad
CONTACT_EMAIL=soporte@municipalidad.gob.pe
# Chatbot de consultas exclusivo del equipo TI (independiente de AI_PROVIDER).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
CHATBOT_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
CHATBOT_LIMITE_CONSULTAS_TECNICO=15
