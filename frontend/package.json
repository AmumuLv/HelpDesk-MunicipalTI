{
  "name": "mesa-ayuda-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interfaz de la Mesa de Ayuda TI con IA para municipalidades",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:inicial": "playwright test -c playwright.inicial.config.ts",
    "verify:ai-texts": "node ../tools/verificar-textos-ia.mjs",
    "verify:clases": "node ../tools/verificar-clases.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
