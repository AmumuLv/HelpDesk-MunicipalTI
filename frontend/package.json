    "@radix-ui/react-tooltip": "^1.3.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^8.21.3",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.469.0",
    "openapi-typescript": "^7.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.1.1",
    "recharts": "^3.10.1",
    "zod": "4.6.7"
